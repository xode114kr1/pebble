// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  nickname          String
  profileImage      String?
  climbingStartDate DateTime?
  height            Int?
  armReach          Int?
  role              Role      @default(USER)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model DifficultyColor {
  id        Int    @id @default(autoincrement())
  name      String
  colorCode String

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  brandColors BrandColor[]

  @@unique([name])
  @@unique([colorCode])
}

model Brand {
  id   Int    @id @default(autoincrement())
  name String @unique

  colors BrandColor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandColor {
  id                Int @id @default(autoincrement())
  brandId           Int
  difficultyColorId Int
  order             Int

  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  difficultyColor DifficultyColor @relation(fields: [difficultyColorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, difficultyColorId])
  @@unique([brandId, order])
}
